<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure simulation. Rules: no Godot, no I/O, no wall clock, no System.Random. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Telo.Sim</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Godot's release export builds this as "ExportRelease", which the SDK doesn't know to optimise -->
    <Optimize Condition="'$(Configuration)' == 'ExportRelease'">true</Optimize>
  </PropertyGroup>
</Project>
